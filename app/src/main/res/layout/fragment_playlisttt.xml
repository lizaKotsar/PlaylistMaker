<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/YP_Light_Gray">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:translationZ="0dp">


        <ImageView
            android:id="@+id/ivCover"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="0dp"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="0dp"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            tools:src="@drawable/cover_placeholder"/>


        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/baseline_arrow_back_24"
            android:tint="@color/Gray_light"
            android:translationZ="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="@dimen/layout_padding_horizontal"
            android:layout_marginEnd="@dimen/layout_padding_horizontal"
            android:textColor="@color/Gray_light"
            android:textSize="24sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="Best songs 2021"
            app:layout_constraintTop_toBottomOf="@id/ivCover"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
             />


        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="@dimen/layout_padding_horizontal"
            android:layout_marginEnd="@dimen/layout_padding_horizontal"
            android:textColor="@color/Gray_light"
            android:textSize="18sp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="2022"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:fontFamily="@font/ys_display_regular"/>


        <TextView
            android:id="@+id/tvMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="@dimen/layout_padding_horizontal"
            android:layout_marginEnd="@dimen/layout_padding_horizontal"
            android:textColor="@color/Gray_light"
            android:textSize="18sp"
            tools:text="300 минут · 98 треков"
            app:layout_constraintTop_toBottomOf="@id/tvDescription"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:fontFamily="@font/ys_display_regular"/>


        <ImageButton
            android:id="@+id/btnShare"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginStart="@dimen/layout_padding_horizontal"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/share_icon"
            android:tint="@color/Gray_light"
            android:translationZ="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvMeta"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"

            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/toc"
            android:tint="@color/Gray_light"
            android:translationZ="8dp"
            app:layout_constraintStart_toEndOf="@id/btnShare"
            app:layout_constraintTop_toTopOf="@id/btnShare" />
    </androidx.constraintlayout.widget.ConstraintLayout>


    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_bottom_sheet_16"
        android:orientation="vertical"
        android:translationZ="12dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="false"
        app:behavior_fitToContents="false"
        app:behavior_expandedOffset="0dp"
        app:behavior_peekHeight="@dimen/playlist_tracks_peek">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bs_handle" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTracks"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:clipToPadding="false"
            tools:listitem="@layout/track_item" />
    </LinearLayout>


    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/menuSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_sheet_16"
        android:visibility="visible"
        android:translationZ="20dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="true">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bs_handle"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/menuHeader"
            android:layout_width="match_parent"
            android:layout_height="@dimen/menu_item_height"
            android:paddingStart="@dimen/menu_side_padding"
            android:paddingEnd="@dimen/menu_side_padding">

            <ImageView
                android:id="@+id/menuCover"
                android:layout_width="@dimen/menu_header_image"
                android:layout_height="@dimen/menu_header_image"
                android:scaleType="centerCrop"
                android:background="@drawable/ic_placeholder"
                android:clipToOutline="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                android:id="@+id/menuTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textSize="16sp"
                android:fontFamily="@font/ys_display_regular"
                android:maxLines="1"
                android:ellipsize="end"
                app:layout_constraintStart_toEndOf="@id/menuCover"
                app:layout_constraintTop_toTopOf="@id/menuCover"
                app:layout_constraintEnd_toEndOf="parent"
                android:textColor="?attr/plTextPrimary"/>

            <TextView
                android:id="@+id/menuCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textSize="11sp"
                android:fontFamily="@font/ys_display_regular"
                android:textColor="?attr/trak"
                android:maxLines="1"
                app:layout_constraintStart_toEndOf="@id/menuCover"
                app:layout_constraintBottom_toBottomOf="@id/menuCover"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/menuShare"
            android:layout_width="match_parent"
            android:layout_height="@dimen/menu_item_height"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/menu_side_padding"
            android:text="@string/playlist_menu_share"
            android:textSize="16sp"
            android:fontFamily="@font/ys_display_regular"
            android:textColor="?attr/plTextPrimary"/>

        <TextView
            android:id="@+id/menuEdit"
            android:layout_width="match_parent"
            android:layout_height="@dimen/menu_item_height"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/menu_side_padding"
            android:text="@string/playlist_menu_edit"
            android:textSize="16sp"
            android:fontFamily="@font/ys_display_regular"
            android:textColor="?attr/plTextPrimary"/>

        <TextView
            android:id="@+id/menuDelete"
            android:layout_width="match_parent"
            android:layout_height="@dimen/menu_item_height"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/menu_side_padding"
            android:text="@string/playlist_menu_delete"
            android:textSize="16sp"
            android:fontFamily="@font/ys_display_regular"
            android:textColor="?attr/plTextPrimary"/>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
